{
  "name": "phpwcms",
  "version": "2.0.0-dev",
  "description": "phpwcms web content management system asset build scripts",
  "private": true,
  "scripts": {
    "build:css": "node include/build/build-css.js",
    "build:css:dev": "node include/build/build-css.js --no-minify",
    "build:js": "node include/build/build-js.js",
    "build": "npm run build:css && npm run build:js",
    "build:dev": "npm run build:css:dev && npm run build:js"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "ace-builds": "^1.44.0",
    "bootstrap": "^4.6.2",
    "cookieconsent2": "^1.0.10-2",
    "dayjs": "^1.11.21",
    "dropzone": "^5.9.3",
    "flag-icons": "^7.5.0",
    "flatpickr": "^4.6.13",
    "glightbox": "^3.3.1",
    "jquery": "^3.7.1",
    "lightningcss": "^1.29.2",
    "terser": "^5.49.0",
    "tom-select": "^2.6.2",
    "vanilla-cookieconsent": "^3.1.0",
    "video.js": "^8.23.9"
  }
}
