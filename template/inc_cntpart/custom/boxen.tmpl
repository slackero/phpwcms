<!--IMAGE_SETTINGS_START//-->
; this is formatted like WIN.INI
; please: do not use comments for value lines
; settings will overwrite CP settings
col            = 3
thumb_class    = img-fluid
text_render    = plain
<!--IMAGE_SETTINGS_END//-->

<!--CUSTOM_HEADER_START//-->
[ATTR_CLASS]<div class="{ATTR_CLASS}"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]<div id="{ATTR_ID}">[/ATTR_ID][/ATTR_CLASS_ELSE]

[TITLE]<h3 class="h4 mb-2">{TITLE}</h3>[/TITLE]
[SUBTITLE]<h4 class="h6 text-muted mb-3">{SUBTITLE}</h4>[/SUBTITLE]

[TEXT]<div class="mb-4">{TEXT}</div>[/TEXT]

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4 team mb-4">
<!--CUSTOM_HEADER_END//-->


<!--CUSTOM_ENTRY_START//-->
<div class="col">
    <div class="card h-100 shadow-sm">
        [CUSTCTP_IMAGE1]
        <a href="mailto:[CUSTCTP_STRING2]{CUSTCTP_STRING2}[/CUSTCTP_STRING2]" class="card-img-top-link">
            {CUSTCTP_IMAGE1}
        </a>
        [/CUSTCTP_IMAGE1]
        <div class="card-body">
            [CUSTCTP_STRING1]<h5 class="card-title h6 mb-2">{CUSTCTP_STRING1}</h5>[/CUSTCTP_STRING1]
            [CUSTCTP_TEXTAREA1]<p class="card-text small text-muted mb-2">{CUSTCTP_TEXTAREA1}</p>[/CUSTCTP_TEXTAREA1]
            [CUSTCTP_FILE1]<div class="card-file mb-2">{CUSTCTP_FILE1}</div>[/CUSTCTP_FILE1]
        </div>
        [CUSTCTP_STRING2]
        <div class="card-footer bg-transparent border-0 pt-0 pb-3">
            <a class="btn btn-sm btn-primary w-100" href="mailto:{CUSTCTP_STRING2}">@@Send email@@</a>
        </div>
        [/CUSTCTP_STRING2]
    </div>
</div>
<!--CUSTOM_ENTRY_END//-->


<!--CUSTOM_ENTRY_SPACER_START//--><!--CUSTOM_ENTRY_SPACER_END//-->
<!--CUSTOM_ROW_SPACER_START//--><!--CUSTOM_ROW_SPACER_END//-->

<!--CUSTOM_FOOTER_START//-->
</div>
[ATTR_CLASS]</div>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]</div>[/ATTR_ID][/ATTR_CLASS_ELSE]
<!--CUSTOM_FOOTER_END//-->
