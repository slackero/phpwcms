<!--
    Custom Content Part template (rendered by include/inc_front/content/cnt60.article.inc.php)

    Field tags used below require the assigned CPT type to define these fields
    (unprefixed form of the CUSTCTP_ field tags):
    url (url), url_target (str), image (image, file ID or path),
    caption (str), infotext (textarea). Wrappers for undefined fields are NOT
    rendered - make sure the CPT schema matches, otherwise the tags leak into
    frontend output.
-->
<!--CUSTOM_HEADER_START//-->
[ATTR_CLASS]<div class="{ATTR_CLASS}"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]<div id="{ATTR_ID}">[/ATTR_ID][/ATTR_CLASS_ELSE]

[TITLE]<h3 class="h4 mb-2">{TITLE}</h3>[/TITLE]
[SUBTITLE]<h4 class="h6 text-muted mb-3">{SUBTITLE}</h4>[/SUBTITLE]
[TEXT]<div class="mb-4">{TEXT}</div>[/TEXT]

<div id="carouselCustom{ID}" class="carousel slide mb-4" data-bs-ride="carousel">
    <!-- Indicators -->
    <div class="carousel-indicators">
        {DATA}
    </div>
    <!-- Slides -->
    <div class="carousel-inner rounded overflow-hidden">
<!--CUSTOM_HEADER_END//-->

<!--CUSTOM_ENTRY_START//-->
        <div class="carousel-item[ITEM_FIRST] active[/ITEM_FIRST]" id="slide-{ITEM_INDEX}">
            [URL]<a href="{URL}"[URL_TARGET] target="{URL_TARGET}"[/URL_TARGET]>[/URL]
                [IMAGE]<img src="{IMAGE}" class="d-block w-100" alt=""{LAZY_LOADING}>[/IMAGE]
            [URL]</a>[/URL]
            [CAPTION]
            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 p-3 rounded">
                <h5>{CAPTION}</h5>
                [INFOTEXT]<p class="mb-0">{INFOTEXT}</p>[/INFOTEXT]
            </div>
            [/CAPTION]
        </div>

        <!--ENTRY_DATA_START//-->
        <button type="button" data-bs-target="#carouselCustom{ID}" data-bs-slide-to="{ITEM_INDEX}"[ITEM_FIRST] class="active" aria-current="true"[/ITEM_FIRST] aria-label="Slide {ITEM_NUM}"></button>
        <!--ENTRY_DATA_END//-->
<!--CUSTOM_ENTRY_END//-->

<!--CUSTOM_ENTRY_SPACER_START//--><!--CUSTOM_ENTRY_SPACER_END//-->

<!--CUSTOM_FOOTER_START//-->
    </div>
    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselCustom{ID}" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">@@Previous@@</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselCustom{ID}" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">@@Next@@</span>
    </button>
</div>
[ATTR_CLASS]</div>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]</div>[/ATTR_ID][/ATTR_CLASS_ELSE]

<!--
    Requires Bootstrap 5 CSS and JavaScript.
    It is recommended to include Bootstrap directly in your main template so it is loaded once
    instead of using the dynamic comment loader here:

    Local:
    CSS: template/lib/bootstrap5/bootstrap.min.css
    JS:  template/lib/bootstrap5/bootstrap.bundle.min.js

    CDN:
    CSS: https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/css/bootstrap.min.css
    JS:  https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/js/bootstrap.bundle.min.js
-->
<!--CUSTOM_FOOTER_END//-->
