<!--
    Custom Content Part template (rendered by include/inc_front/content/cnt60.article.inc.php)

    Field tags used below require the assigned CPT type to define these fields
    (unprefixed form of the CUSTCTP_ field tags):
    caption (str), image (image, file ID or path), infotext (textarea),
    url (url), url_target (str). Wrappers for undefined fields are NOT rendered -
    make sure the CPT schema matches, otherwise the tags leak into frontend output.
-->
<!--CUSTOM_HEADER_START//-->
[ATTR_CLASS]<div class="{ATTR_CLASS}"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]<div id="{ATTR_ID}">[/ATTR_ID][/ATTR_CLASS_ELSE]

[TITLE]<h3 class="h4 mb-2">{TITLE}</h3>[/TITLE]
[SUBTITLE]<h4 class="h6 text-muted mb-3">{SUBTITLE}</h4>[/SUBTITLE]
[TEXT]<div class="mb-4">{TEXT}</div>[/TEXT]

<div class="accordion accordion-flush mb-4" id="customAccordion{ID}">
<!--CUSTOM_HEADER_END//-->

<!--CUSTOM_ENTRY_START//-->
    <div class="accordion-item" id="accordion-item-{ITEM_INDEX}">
        <h2 class="accordion-header" id="heading-{ID}-{ITEM_INDEX}">
            <button class="accordion-button[ITEM_FIRST] [/ITEM_FIRST][ITEM_FIRST_ELSE]collapsed[/ITEM_FIRST_ELSE]" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{ID}-{ITEM_INDEX}" aria-expanded="[ITEM_FIRST]true[/ITEM_FIRST][ITEM_FIRST_ELSE]false[/ITEM_FIRST_ELSE]" aria-controls="collapse-{ID}-{ITEM_INDEX}">
                [CAPTION]{CAPTION}[/CAPTION][CAPTION_ELSE]Item #{ITEM_NUM}[/CAPTION_ELSE]
            </button>
        </h2>
        <div id="collapse-{ID}-{ITEM_INDEX}" class="accordion-collapse collapse[ITEM_FIRST] show[/ITEM_FIRST]" aria-labelledby="heading-{ID}-{ITEM_INDEX}" data-bs-parent="#customAccordion{ID}">
            <div class="accordion-body">
                [IMAGE]<img src="{IMAGE}" class="img-fluid mb-3" alt=""{LAZY_LOADING}>[/IMAGE]
                [INFOTEXT]{INFOTEXT}[/INFOTEXT]
                [URL]
                <div class="mt-3">
                    <a href="{URL}"[URL_TARGET] target="{URL_TARGET}"[/URL_TARGET] class="btn btn-sm btn-outline-primary">@@More@@ &raquo;</a>
                </div>
                [/URL]
            </div>
        </div>
    </div>
<!--CUSTOM_ENTRY_END//-->

<!--CUSTOM_ENTRY_SPACER_START//--><!--CUSTOM_ENTRY_SPACER_END//-->

<!--CUSTOM_FOOTER_START//-->
</div>
[ATTR_CLASS]</div>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]</div>[/ATTR_ID][/ATTR_CLASS_ELSE]
<!--CUSTOM_FOOTER_END//-->
