<!-- JS:
	document.addEventListener('DOMContentLoaded', function() {
		var container = document.getElementById('slider_container_{ID}');
		if (!container) return;

		var prev = document.getElementById('slider_prev_{ID}');
		var next = document.getElementById('slider_next_{ID}');

		function getStep() {
			var item = container.querySelector('.inner > *');
			return item ? (item.getBoundingClientRect().width + 5) : 106;
		}

		if (next) {
			next.addEventListener('click', function(e) {
				e.preventDefault();
				var maxScroll = container.scrollWidth - container.clientWidth;
				if (container.scrollLeft >= maxScroll - 2) {
					container.scrollTo({ left: 0, behavior: 'smooth' });
				} else {
					container.scrollBy({ left: getStep(), behavior: 'smooth' });
				}
			});
		}

		if (prev) {
			prev.addEventListener('click', function(e) {
				e.preventDefault();
				if (container.scrollLeft <= 2) {
					container.scrollTo({ left: container.scrollWidth - container.clientWidth, behavior: 'smooth' });
				} else {
					container.scrollBy({ left: -getStep(), behavior: 'smooth' });
				}
			});
		}
	});
