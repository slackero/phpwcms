<!--IMAGES_HEADER_START//-->
[TITLE]<h3>{TITLE}</h3>[/TITLE]
[SUBTITLE]<h4>{SUBTITLE}</h4>[/SUBTITLE]

<div style="margin: 10px 0;">
	<a href="#" id="slider_prev_{ID}">&laquo; @@left@@</a> | <a href="#" id="slider_next_{ID}">@@right@@ &raquo;</a>
</div>

<div id="slider_container_{ID}" class="slider">
<div class="inner">
<!--IMAGES_HEADER_END//-->

<!--IMAGES_ENTRY_START//-->
	[URL]<a href="{URL}"[URL_TARGET] target="{URL_TARGET}"[/URL_TARGET]>[/URL]{IMAGE}[URL]</a>[/URL]
<!--IMAGES_ENTRY_END//-->

<!--IMAGES_FOOTER_START//-->
</div>
</div>
