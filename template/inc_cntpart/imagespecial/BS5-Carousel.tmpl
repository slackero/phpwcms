<!--IMAGE_SETTINGS_START//-->
; Bootstrap 5 Images Special Carousel
width          = 1200
height         = 500
col            = 1
zoom           = 0
crop           = 1
lightbox       = 0
nocaption      = 0
thumb_class    = d-block w-100
text_render    = html
<!--IMAGE_SETTINGS_END//-->

<!--IMAGES_HEADER_START//-->
[ATTR_CLASS]<div class="{ATTR_CLASS}"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]<div id="{ATTR_ID}">[/ATTR_ID][/ATTR_CLASS_ELSE]

[TITLE]<h3 class="h4 mb-2">{TITLE}</h3>[/TITLE]
[SUBTITLE]<h4 class="h6 text-muted mb-3">{SUBTITLE}</h4>[/SUBTITLE]
[TEXT]<div class="mb-4">{TEXT}</div>[/TEXT]

<div id="carouselSpecial{ID}" class="carousel slide mb-4" data-bs-ride="carousel">
    <!-- Indicators -->
    <div class="carousel-indicators">
        {DATA}
    </div>
    <!-- Slides -->
    <div class="carousel-inner rounded overflow-hidden">
<!--IMAGES_HEADER_END//-->

<!--IMAGES_ENTRY_START//-->
        <div class="carousel-item[IMAGE_FIRST] active[/IMAGE_FIRST]" id="slide-special-{IMGID}">
            [URL]<a href="{URL}"[URL_TARGET] target="{URL_TARGET}"[/URL_TARGET]>[/URL]
                {IMAGE}
            [URL]</a>[/URL]
            [CAPTION]
            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 p-3 rounded">
                <h5>{CAPTION}</h5>
                [INFOTEXT]<p class="mb-0">{INFOTEXT}</p>[/INFOTEXT]
            </div>
            [/CAPTION]
        </div>

        <!--ENTRY_DATA_START//-->
        <button type="button" data-bs-target="#carouselSpecial{ID}" data-bs-slide-to="{ROW_COUNT}"[IMAGE_FIRST] class="active" aria-current="true"[/IMAGE_FIRST] aria-label="Slide {ROW}"></button>
        <!--ENTRY_DATA_END//-->
<!--IMAGES_ENTRY_END//-->

<!--IMAGES_ENTRY_SPACER_START//--><!--IMAGES_ENTRY_SPACER_END//-->
<!--IMAGES_ROW_SPACER_START//--><!--IMAGES_ROW_SPACER_END//-->

<!--IMAGES_FOOTER_START//-->
    </div>
    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselSpecial{ID}" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">@@Previous@@</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselSpecial{ID}" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">@@Next@@</span>
    </button>
</div>
[ATTR_CLASS]</div>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]</div>[/ATTR_ID][/ATTR_CLASS_ELSE]

<!--
    Requires Bootstrap 5 CSS and JavaScript in your main template so it is loaded once.
    CSS: https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/css/bootstrap.min.css
    JS:  https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/js/bootstrap.bundle.min.js
-->
<!-- CSS: template/lib/bootstrap5/bootstrap.min.css -->
<!-- JS: template/lib/bootstrap5/bootstrap.bundle.min.js -->
<!--IMAGES_FOOTER_END//-->
