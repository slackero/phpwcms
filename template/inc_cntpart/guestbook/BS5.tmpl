<!--
    Sign form: the renderer wraps this section in its own <form> tag
    (incl. tracking token) — do NOT add <form> here.
-->
<!--FORM_START//-->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h4 class="card-title h5 mb-0">@@Leave an Entry@@</h4>
    </div>
    <div class="card-body p-4">
<!--FORM_ERROR_START//-->
        <div class="alert alert-danger" role="alert">
            <strong>@@Please correct the following errors:@@</strong>
            <ul class="mb-0 mt-2">
                [ERROR_EMAIL]<li>{ERROR_EMAIL}</li>[/ERROR_EMAIL]
                [ERROR_NAME]<li>{ERROR_NAME}</li>[/ERROR_NAME]
                [ERROR_URL]<li>{ERROR_URL}</li>[/ERROR_URL]
                [ERROR_CAPTCHA]<li>{ERROR_CAPTCHA}</li>[/ERROR_CAPTCHA]
                [ERROR_IMG]<li>{ERROR_IMG}</li>[/ERROR_IMG]
                [ERROR_IMGSIZE]<li>{ERROR_IMGSIZE}</li>[/ERROR_IMGSIZE]
                [ERROR_IMGSAVE]<li>{ERROR_IMGSAVE}</li>[/ERROR_IMGSAVE]
                [ERROR_IMGWRITE]<li>{ERROR_IMGWRITE}</li>[/ERROR_IMGWRITE]
                [ERROR_IMGFORMAT]<li>{ERROR_IMGFORMAT}</li>[/ERROR_IMGFORMAT]
                [ERROR_IMGUPLOAD]<li>{ERROR_IMGUPLOAD}</li>[/ERROR_IMGUPLOAD]
            </ul>
        </div>
<!--FORM_ERROR_END//-->
        <div class="row g-3">
            <div class="col-md-6">
                <label for="guestbook_name" class="form-label">@@Name@@ *</label>
                <input type="text" name="guestbook_name" id="guestbook_name" value="{NAME}" class="form-control" autocomplete="name" required>
            </div>
            <div class="col-md-6">
                <label for="guestbook_email" class="form-label">@@Email@@ *</label>
                <input type="email" name="guestbook_email" id="guestbook_email" value="{EMAIL}" class="form-control" autocomplete="email" required>
            </div>
            <div class="col-12">
                <label for="guestbook_url" class="form-label">@@Website@@</label>
                <input type="url" name="guestbook_url" id="guestbook_url" value="{URL}" class="form-control" placeholder="https://">
            </div>
            <div class="col-12">
                <label for="guestbook_msg" class="form-label">@@Message@@ *</label>
                <textarea name="guestbook_msg" id="guestbook_msg" rows="5" class="form-control" required>{MSG}</textarea>
            </div>
            <div class="col-12">
                <label class="form-label d-block">@@display@@</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="guestbook_show" id="guestbook_show0" value="0"{GBSHOW_0}>
                    <label class="form-check-label" for="guestbook_show0">@@show email@@</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="guestbook_show" id="guestbook_show1" value="1"{GBSHOW_1}>
                    <label class="form-check-label" for="guestbook_show1">@@hide email@@</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="guestbook_show" id="guestbook_show2" value="2"{GBSHOW_2}>
                    <label class="form-check-label" for="guestbook_show2">@@as "info at mail dot com"@@</label>
                </div>
            </div>
<!--IMAGE_UPLOAD_START//-->
            <div class="col-12">
                <label for="guestbook_image" class="form-label">@@Attach Image (jpg, gif, png)@@</label>
                <input type="file" name="guestbook_image" id="guestbook_image" class="form-control" accept="image/*">
            </div>
<!--IMAGE_UPLOAD_END//-->
<!--CAPTCHA_START//-->
            <div class="col-12">
                <label class="form-label d-block" for="guestbook_captcha">@@Security Check@@</label>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    {CAPTCHA}
                    <input type="text" name="guestbook_captcha" id="guestbook_captcha" class="form-control" style="max-width:120px;" required>
                </div>
            </div>
<!--CAPTCHA_END//-->
            <div class="col-12 pt-2">
                <button type="submit" name="guestbook_send" class="btn btn-primary">@@Submit Entry@@</button>
            </div>
        </div>
    </div>
</div>
<!--FORM_END//-->

<!--FORM_SUCCESS_START//-->
<div class="alert alert-success mb-4" role="alert">
    <h5 class="alert-heading">@@Thanks@@ {NAME}!</h5>
    <p class="mb-0">@@Your entry has been submitted successfully.@@</p>
</div>
<!--FORM_SUCCESS_END//-->

<!--
    Navigation: {FIRST:label}, {BACK:label}, {NEXT:label}, {LAST:label}
    render a complete <a href> around the label — no surrounding <a> in template.
    {PAGE:COUNT:SPACER|PREFIX|SUFFIX}, {ARCHIVE:...}, {JUMP:...}
-->
<!--NAV_START//-->
<nav aria-label="@@Guestbook@@" class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 small">
    <div class="gbNavPages">
        <strong>{FIRST:&laquo;} {BACK:&lsaquo;}</strong>
        {PAGE:5:&nbsp;|<span class="fw-bold">|</span>}
        <strong>{NEXT:&rsaquo;} {LAST:&raquo;}</strong>
    </div>
    <div class="text-muted">
        {ARCHIVE:%Y/%m|all entries|go|&nbsp;}&nbsp;{JUMP:page|go|&nbsp;}
    </div>
</nav>
<!--NAV_END//-->

<!--GUESTBOOK_START//-->
{FORM} {NAV}
<div class="guestbook-entries mb-4">
<!--GUESTBOOK_ENTRY_START//-->
    <div class="card mb-3 border-0 shadow-sm" id="gb-entry-{DBID}">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <h5 class="card-title h6 mb-0 text-dark fw-bold">
                    [URL]<a href="{URL}" target="_blank" rel="noopener noreferrer">{NAME}</a>[/URL][URL_ELSE]{NAME}[/URL_ELSE]
                </h5>
                <small class="text-muted">{TIMESTAMP:m/d/Y H:i}</small>
            </div>
            [IMAGE]<div class="my-3">{IMAGE:200x200x0}</div>[/IMAGE]
            [MSG]<p class="card-text text-secondary mb-0">{MSG}</p>[/MSG]
        </div>
    </div>
<!--GUESTBOOK_ENTRY_END//-->
</div>
<!--GUESTBOOK_END//-->

<!--COMMENT_START//--><span class="gbComment">|</span><!--COMMENT_END//-->

<!--LOGIN_INFO_START//-->
<div class="alert alert-info mb-4" role="alert">
    <p class="mb-0">@@Guestbook is accessible for logged in users only.@@</p>
    <p class="mb-0">@@You can post to this guestbook only when you are logged in.@@</p>
    <p class="mb-0">@@Please log in here.@@</p>
</div>
<!--LOGIN_INFO_END//-->