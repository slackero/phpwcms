<!--FORM_START//-->
[ATTR_CLASS]<div class="{ATTR_CLASS}"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]<div id="{ATTR_ID}">[/ATTR_ID][/ATTR_CLASS_ELSE]
[TITLE]<h3 class="h4 mb-2">{TITLE}</h3>[/TITLE]
[SUBTITLE]<h4 class="h6 text-muted mb-3">{SUBTITLE}</h4>[/SUBTITLE]

<!--FORM_ERROR_START//-->
<div class="alert alert-danger mb-4" role="alert">
    <strong>@@Please correct the following errors:@@</strong>
    <ul class="mb-0 mt-2">
        [ERROR_EMAIL]<li>{ERROR_EMAIL}</li>[/ERROR_EMAIL]
        [ERROR_NAME]<li>{ERROR_NAME}</li>[/ERROR_NAME]
        [ERROR_URL]<li>{ERROR_URL}</li>[/ERROR_URL]
        [ERROR_CAPTCHA]<li>{ERROR_CAPTCHA}</li>[/ERROR_CAPTCHA]
        [ERROR_IMG]<li>{ERROR_IMG}</li>[/ERROR_IMG]
        [ERROR_IMGSIZE]<li>{ERROR_IMGSIZE}</li>[/ERROR_IMGSIZE]
        [ERROR_IMGSAVE]<li>{ERROR_IMGSAVE}</li>[/ERROR_IMGSAVE]
        [ERROR_IMGWRITE]<li>{ERROR_IMGWRITE}</li>[/ERROR_IMGWRITE]
        [ERROR_IMGFORMAT]<li>{ERROR_IMGFORMAT}</li>[/ERROR_IMGFORMAT]
        [ERROR_IMGUPLOAD]<li>{ERROR_IMGUPLOAD}</li>[/ERROR_IMGUPLOAD]
    </ul>
</div>
<!--FORM_ERROR_END//-->

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h4 class="card-title h5 mb-0">@@Leave an Entry@@</h4>
    </div>
    <div class="card-body p-4">
        <form name="guestbook_form" method="post" action="{FORM_ACTION}" enctype="multipart/form-data">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="guestbook_name_{ID}" class="form-label">@@Name@@ *</label>
                    <input type="text" name="guestbook_name" id="guestbook_name_{ID}" value="{NAME}" class="form-control" autocomplete="name" required>
                </div>
                <div class="col-md-6">
                    <label for="guestbook_email_{ID}" class="form-label">@@Email@@ *</label>
                    <input type="email" name="guestbook_email" id="guestbook_email_{ID}" value="{EMAIL}" class="form-control" autocomplete="email" required>
                </div>
                <div class="col-12">
                    <label for="guestbook_url_{ID}" class="form-label">@@Website@@</label>
                    <input type="url" name="guestbook_url" id="guestbook_url_{ID}" value="{URL}" class="form-control" placeholder="https://">
                </div>
                <div class="col-12">
                    <label for="guestbook_msg_{ID}" class="form-label">@@Message@@ *</label>
                    <textarea name="guestbook_msg" id="guestbook_msg_{ID}" rows="5" class="form-control" required>{MSG}</textarea>
                </div>
                <div class="col-12">
                    <label class="form-label d-block">@@display@@</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="guestbook_show" id="guestbook_show0_{ID}" value="0"{GBSHOW_0}>
                        <label class="form-check-label" for="guestbook_show0_{ID}">@@show email@@</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="guestbook_show" id="guestbook_show1_{ID}" value="1"{GBSHOW_1}>
                        <label class="form-check-label" for="guestbook_show1_{ID}">@@hide email@@</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="guestbook_show" id="guestbook_show2_{ID}" value="2"{GBSHOW_2}>
                        <label class="form-check-label" for="guestbook_show2_{ID}">@@as "info at mail dot com"@@</label>
                    </div>
                </div>
<!--IMAGE_UPLOAD_START//-->
                <div class="col-12">
                    <label for="guestbook_image_{ID}" class="form-label">@@Attach Image (jpg, gif, png)@@</label>
                    <input type="file" name="guestbook_image" id="guestbook_image_{ID}" class="form-control" accept="image/*">
                </div>
<!--IMAGE_UPLOAD_END//-->
<!--CAPTCHA_START//-->
                <div class="col-12">
                    <label class="form-label d-block">@@Security Check@@</label>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        {CAPTCHA}
                        <input type="text" name="guestbook_captcha" id="guestbook_captcha_{ID}" class="form-control" style="max-width:120px;" placeholder="@@Type code@@" required>
                    </div>
                </div>
<!--CAPTCHA_END//-->
                <div class="col-12 pt-2">
                    <button type="submit" name="guestbook_send" class="btn btn-primary">@@Submit Entry@@</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!--FORM_END//-->

<!--FORM_SUCCESS_START//-->
<div class="alert alert-success mb-4" role="alert">
    <h5 class="alert-heading">@@Thank you@@, {NAME}!</h5>
    <p class="mb-0">@@Your entry has been submitted successfully.@@</p>
</div>
<!--FORM_SUCCESS_END//-->

<!--NAV_START//-->
<nav aria-label="Guestbook navigation" class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <span class="btn-group btn-group-sm" role="group">
            <a href="{FIRST}" class="btn btn-outline-secondary" title="First">&laquo;</a>
            <a href="{BACK}" class="btn btn-outline-secondary" title="Previous">&lsaquo;</a>
            {PAGE:5:&nbsp;|class="btn btn-primary"|class="btn btn-outline-secondary"}
            <a href="{NEXT}" class="btn btn-outline-secondary" title="Next">&rsaquo;</a>
            <a href="{LAST}" class="btn btn-outline-secondary" title="Last">&raquo;</a>
        </span>
    </div>
    <div class="small text-muted">
        {ARCHIVE:%Y/%m|all entries|go|&nbsp;}&nbsp;{JUMP:page|go|&nbsp;}
    </div>
</nav>
<!--NAV_END//-->

<!--GUESTBOOK_START//-->
<div class="guestbook-entries mb-4">
<!--GUESTBOOK_END//-->

<!--GUESTBOOK_ENTRY_START//-->
<div class="card mb-3 border-0 shadow-sm" id="gb-entry-{DBID}">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-baseline mb-2">
            <h5 class="card-title h6 mb-0 text-dark fw-bold">
                [URL]<a href="{URL}" target="_blank" rel="noopener noreferrer">[/URL]{NAME}[URL]</a>[/URL]
            </h5>
            <small class="text-muted">{TIMESTAMP:m/d/Y H:i}</small>
        </div>
        [IF_IMAGE]
        <div class="my-3">
            {IMAGE:200x200x0}
        </div>
        [/IF_IMAGE]
        <p class="card-text text-secondary mb-0">{MSG}</p>
    </div>
</div>
<!--GUESTBOOK_ENTRY_END//-->

<!--GUESTBOOK_START//-->
</div>
<!--GUESTBOOK_END//-->

