<!--FILE_SETTINGS_START//-->
; this is formatted like WIN.INI
; please: do not use comments for value lines
icon_path           = ""
icon_name           = ""
thumbnail           = 0
thumbnail_width     = 50
thumbnail_height    = 50
thumbnail_crop      = 1
lightbox_init       = 0
file_size_round     = 1
file_size_space     = " "
date_format         = "%m/%d/%y"
set_locale          = "en_US.UTF-8"
;set_locale          = "de_DE.UTF-8"
inline_download     = 1
<!--FILE_SETTINGS_END//-->
[HAS_FILES]
<span class="d-inline-block files-inline files-inline-count-{FILE_COUNT}[ATTR_CLASS] {ATTR_CLASS}[/ATTR_CLASS]"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>
    <!--FILE_ENTRY_START//-->
    <a href="{FILE_LINK}"{FILE_TARGET} title="@@Download@@ &raquo;{FILE_NAME}&laquo;" rel="nofollow" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-file-earmark-arrow-down"></i>
        [FILE_DESCRIPTION]{FILE_DESCRIPTION}[/FILE_DESCRIPTION][FILE_DESCRIPTION_ELSE][FILE_TITLE]{FILE_TITLE}[/FILE_TITLE][FILE_TITLE_ELSE]{FILE_NAME}[/FILE_TITLE_ELSE][/FILE_DESCRIPTION_ELSE]
    </a>
    <span class="badge bg-light text-dark border">({FILE_EXT}, {FILE_SIZE})</span>
    <!--FILE_ENTRY_END//-->
</span>
[/HAS_FILES]
