<!--NEWS_SETTINGS_START//-->
; how many news should be listed per row
news_per_row = 2

; cut teaser text
; 0 means no limit
news_teaser_limit_chars = 0
news_teaser_limit_words = 0
news_teaser_limit_ellipse = &hellip;

; template for files - the same as used
; for content part files , default:
; files_template_list = default
files_template_detail = default
files_direct_download = 0

; gallery supported image formats
gallery_allowed_ext = jpg,jpeg,png,gif,svg,webp,avif
; use the file info/copyright as used defined in file center
gallery_filecenter_info = 1
<!--NEWS_SETTINGS_END//-->

<!--NEWS_LIST_START//-->
[ATTR_CLASS]<div class="{ATTR_CLASS}"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]<div id="{ATTR_ID}">[/ATTR_ID][/ATTR_CLASS_ELSE]
[TITLE]<h3 class="h4 mb-2">{TITLE}</h3>[/TITLE]
[SUBTITLE]<h4 class="h6 text-muted mb-3">{SUBTITLE}</h4>[/SUBTITLE]
[NEWS_ENTRIES]{NEWS_ENTRIES}[/NEWS_ENTRIES]
[PAGINATE]
<nav aria-label="News pagination" class="news-pagination d-flex justify-content-between align-items-center flex-wrap gap-2 my-3">
    <span class="btn-group btn-group-sm" role="group">
        [PAGE_PREV]<a href="{PAGE_PREV}[ATTR_ID]#{ATTR_ID}[/ATTR_ID]" class="btn btn-outline-secondary">@@&laquo; previous@@</a>[/PAGE_PREV]
        [PAGE_PREV_ELSE]<span class="btn btn-outline-secondary disabled">@@previous@@</span>[/PAGE_PREV_ELSE]
        [PAGE_NEXT]<a href="{PAGE_NEXT}[ATTR_ID]#{ATTR_ID}[/ATTR_ID]" class="btn btn-outline-secondary">@@next &raquo;@@</a>[/PAGE_NEXT]
        [PAGE_NEXT_ELSE]<span class="btn btn-outline-secondary disabled">@@next@@</span>[/PAGE_NEXT_ELSE]
    </span>
    <small class="text-muted">@@page@@ {PAGE_CURRENT}/{PAGE_TOTAL}</small>
</nav>
[/PAGINATE]
[ATTR_CLASS]</div>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]</div>[/ATTR_ID][/ATTR_CLASS_ELSE]
<!--NEWS_LIST_END//-->

<!--NEWS_LIST_ENTRY_START//-->
    <div class="card border-0 shadow-sm mb-4 newsEntry[PRIO] prio{PRIO}[/PRIO][FIRST] first[/FIRST][LAST] last[/LAST][IS_ARCHIVE] news-item-archived[/IS_ARCHIVE][IS_ARCHIVE_ELSE] news-item-live[/IS_ARCHIVE_ELSE]" id="news-{ID}">
    <div class="card-body">
    [NEWS_TITLE]<h2 class="card-title h4 mb-2">{NEWS_TITLE}</h2>[/NEWS_TITLE]
    [NEWS_SUBTITLE]<h3 class="h6 text-muted mb-3">{NEWS_SUBTITLE}</h3>[/NEWS_SUBTITLE]
    [NEWS_TOPIC]<p><strong>{NEWS_TOPIC}</strong></p>[/NEWS_TOPIC]
    [IMAGE]
        [ZOOM_ELSE]
            [IMAGE_URL]<a href="{IMAGE_URL}"{IMAGE_URL_TARGET}[TITLE] title="{TITLE}"[/TITLE] class="d-inline-block">[/IMAGE_URL]
                <img src="{PHPWCMS_RESIZE_IMAGE}/100x100x1/{IMAGE_ID}{IMAGE_EXT}" alt="[ALT]{ALT}[/ALT][ALT_ELSE]{IMAGE}[/ALT_ELSE]" class="img-fluid rounded mb-2"{LAZY_LOADING}>
            [IMAGE_URL]</a>[/IMAGE_URL]
            [CAPTION]<p class="text-muted small">{CAPTION}[COPYRIGHT] <span class="copyright">&copy; {COPYRIGHT}</span>[/COPYRIGHT]</p>[/CAPTION]
        [/ZOOM_ELSE]
        [ZOOM]
            <a href="{PHPWCMS_RESIZE_IMAGE}/600x400/{IMAGE_ID}{IMAGE_EXT}"{LIGHTBOX}[LIGHTBOX_CAPTION] title="{LIGHTBOX_CAPTION}[LIGHTBOX_COPYRIGHT], {LIGHTBOX_COPYRIGHT}[/LIGHTBOX_COPYRIGHT]"[/LIGHTBOX_CAPTION]>
                <img src="{PHPWCMS_RESIZE_IMAGE}/100x100x1/{IMAGE_ID}{IMAGE_EXT}" alt="[ALT]{ALT}[/ALT][ALT_ELSE]{IMAGE}[/ALT_ELSE]" class="img-fluid rounded mb-2"{LAZY_LOADING}>
            </a>
        [/ZOOM]
    [/IMAGE]
    [NEWS_TEASER]<div class="news-teaser">{NEWS_TEASER}</div>[/NEWS_TEASER]
    [NEWS_TEASER_ELSE][NEWS_TEXT]<div class="news-text">{NEWS_TEXT}</div>[/NEWS_TEXT][/NEWS_TEASER_ELSE]
    [AUTHOR]<p class="text-muted small mb-2">{AUTHOR}[PLACE], {PLACE}[/PLACE]</p>[/AUTHOR][AUTHOR_ELSE][PLACE]<p class="text-muted small mb-2">{PLACE}</p>[/PLACE][/AUTHOR_ELSE]
    [URL]
        <p class="mb-2"><a href="{URL}"{URL_TARGET} class="btn btn-sm btn-outline-primary">[URL_TEXT]{URL_TEXT}[/URL_TEXT][URL_TEXT_ELSE]@@more@@[/URL_TEXT_ELSE]</a></p>
    [/URL]
    [GALLERY]
        <div class="row row-cols-2 row-cols-md-4 g-2 image-gallery mt-1">
            <!--GALLERY_ITEM_START//-->
            <div class="col image-gallery-item">
                <a href="{PHPWCMS_RESIZE_IMAGE}/900x600/{IMAGE_HASH}.{IMAGE_EXT}"[CAPTION] title="{CAPTION}[COPYRIGHT], {COPYRIGHT}[/COPYRIGHT]"[/CAPTION] rel="lightbox" data-gallery="1" class="d-block">
                    <img src="{PHPWCMS_RESIZE_IMAGE}/50x50x1/{IMAGE_HASH}.{IMAGE_EXT}" alt="{IMAGE_NAME}" class="img-fluid rounded"{LAZY_LOADING}>
                </a>
            </div>
            <!--GALLERY_ITEM_END//-->
            {GALLERY}
        </div>
    [/GALLERY]
    [FILES]{FILES}[/FILES]
    [NEWS_DETAIL_LINK]
        <p class="link mb-0"><a href="{NEWS_DETAIL_LINK}" class="btn btn-sm btn-primary">@@read &raquo;@@</a></p>
    [/NEWS_DETAIL_LINK]
    [NEWS_TAGS]<div class="news-tags mt-2">{NEWS_TAGS}</div>[/NEWS_TAGS]
    </div>
    </div>
<!--NEWS_LIST_ENTRY_END//-->

<!--NEWS_LIST_ENTRY_SPACE_START//-->

    <!-- space between news items -->

