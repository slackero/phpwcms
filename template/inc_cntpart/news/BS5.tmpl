<!--NEWS_DETAIL_START//-->
[ATTR_CLASS]<div class="{ATTR_CLASS}"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]<div id="{ATTR_ID}">[/ATTR_ID][/ATTR_CLASS_ELSE]
<div class="card border-0 shadow-sm news[IS_ARCHIVE] news-archived[/IS_ARCHIVE][IS_ARCHIVE_ELSE] news-live[/IS_ARCHIVE_ELSE] mb-4">
    <div class="card-body">
    <div class="news-header mb-3">
        [TITLE]<h3 class="h4 mb-1">{TITLE}</h3>[/TITLE]
        [SUBTITLE]<h4 class="h6 text-muted mb-0">{SUBTITLE}</h4>[/SUBTITLE]
    </div>
    [NEWS_TITLE]<h1 class="h3 mb-2">{NEWS_TITLE}</h1>[/NEWS_TITLE]
    [NEWS_SUBTITLE]<h2 class="h5 text-muted mb-3">{NEWS_SUBTITLE}</h2>[/NEWS_SUBTITLE]
    [NEWS_TOPIC]<p class="text-muted"><strong>{NEWS_TOPIC}</strong>[AUTHOR], {AUTHOR}[PLACE], {PLACE}[/PLACE][/AUTHOR][AUTHOR_ELSE][PLACE], {PLACE}[/PLACE][/AUTHOR_ELSE]</p>[/NEWS_TOPIC]
    [IMAGE]
        [ZOOM_ELSE]
            [IMAGE_URL]<a href="{IMAGE_URL}"{IMAGE_URL_TARGET}[TITLE] title="{TITLE}"[/TITLE] class="d-inline-block">[/IMAGE_URL]
                <img src="{PHPWCMS_RESIZE_IMAGE}/150x150x1/{IMAGE_ID}{IMAGE_EXT}" alt="[ALT]{ALT}[/ALT][ALT_ELSE]{IMAGE}[/ALT_ELSE]" class="img-fluid rounded mb-2"{LAZY_LOADING}>
            [IMAGE_URL]</a>[/IMAGE_URL]
            [CAPTION]<p class="text-muted small">{CAPTION}[COPYRIGHT] <span class="copyright">&copy; {COPYRIGHT}</span>[/COPYRIGHT]</p>[/CAPTION]
        [/ZOOM_ELSE]
        [ZOOM]
            <a href="{PHPWCMS_RESIZE_IMAGE}/600x400/{IMAGE_ID}{IMAGE_EXT}" target="_blank"{LIGHTBOX}[LIGHTBOX_CAPTION] title="{LIGHTBOX_CAPTION}[LIGHTBOX_COPYRIGHT], {LIGHTBOX_COPYRIGHT}[/LIGHTBOX_COPYRIGHT]"[/LIGHTBOX_CAPTION]>
                <img src="{PHPWCMS_RESIZE_IMAGE}/100x100x1/{IMAGE_ID}{IMAGE_EXT}" alt="[ALT]{ALT}[/ALT][ALT_ELSE]{IMAGE}[/ALT_ELSE]" class="img-fluid rounded mb-2"{LAZY_LOADING}>
            </a>
        [/ZOOM]
    [/IMAGE]
    [NEWS_TEXT]<div class="news-text">{NEWS_TEXT}</div>[/NEWS_TEXT]
    [NEWS_TEXT_ELSE][NEWS_TEASER]<div class="news-teaser">{NEWS_TEASER}</div>[/NEWS_TEASER][/NEWS_TEXT_ELSE]
    [URL]
        <p><a href="{URL}"{URL_TARGET} class="btn btn-sm btn-outline-primary">[URL_TEXT]{URL_TEXT}[/URL_TEXT][URL_TEXT_ELSE]@@more@@[/URL_TEXT_ELSE]</a></p>
    [/URL]
    [GALLERY]
        <div class="row row-cols-2 row-cols-md-4 g-2 image-gallery mt-1">
            <!--GALLERY_ITEM_START//-->
            <div class="col image-gallery-item">
                <a href="{PHPWCMS_RESIZE_IMAGE}/900x600/{IMAGE_HASH}.{IMAGE_EXT}"[CAPTION] title="{CAPTION}[COPYRIGHT], {COPYRIGHT}[/COPYRIGHT]"[/CAPTION] rel="lightbox" data-gallery="1" class="d-block">
                    <img src="{PHPWCMS_RESIZE_IMAGE}/150x100x1/{IMAGE_HASH}.{IMAGE_EXT}" alt="{IMAGE_NAME}" class="img-fluid rounded"{LAZY_LOADING}>
                </a>
            </div>
            <!--GALLERY_ITEM_END//-->
            {GALLERY}
        </div>
    [/GALLERY]
    [FILES]{FILES}[/FILES]
    [NEWS_LIST_LINK]
        <p class="link mb-0"><a href="{NEWS_LIST_LINK}" class="btn btn-sm btn-secondary">@@&laquo; back@@</a></p>
    [/NEWS_LIST_LINK]
    </div>
</div>
[ATTR_CLASS]</div>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]</div>[/ATTR_ID][/ATTR_CLASS_ELSE]
<!--NEWS_DETAIL_END//-->