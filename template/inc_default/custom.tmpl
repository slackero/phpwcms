<!--
    Default example template for Custom Content Parts (CPT)
    (rendered by include/inc_front/content/cnt60.article.inc.php)

    Custom Content Parts are defined in backend module "Modules → Custom CP".
    Each CPT defines its own set of fields; reference them here by key.

    Per-element loop meta tags:
      {ITEM_INDEX}    0-based index of current element
      {ITEM_NUM}      1-based position
      {ITEM_TOTAL}    total number of elements
      [ITEM_FIRST]...[/ITEM_FIRST]           first element
      [ITEM_LAST]...[/ITEM_LAST]             last element
      [ITEM_FIRST_ELSE]...[/ITEM_FIRST_ELSE] all but the first element
      {DATA}                                     filled with ENTRY_DATA sections (one per element)

    CPT fields (replace <fieldname> by the field key of your CPT):
      {CUSTCTP_<fieldname>} or {<fieldname>}                    field value
      [CUSTCTP_<fieldname>]...[/CUSTCTP_<fieldname>]           only when field not empty
      [CUSTCTP_<fieldname>_ELSE]...[/CUSTCTP_<fieldname>_ELSE] only when field empty
      (field tags exist with and without CUSTCTP_ prefix)

    Content part meta:
      {ID}, [TITLE]{TITLE}[/TITLE], [SUBTITLE]{SUBTITLE}[/SUBTITLE], [TEXT]{TEXT}[/TEXT],
      [HTML]{HTML}[/HTML], [BEFORE]/[AFTER], [ANCHOR]{ANCHOR}[/ANCHOR],
      [ATTR_CLASS]/[ATTR_ID], {CPT_KEY}, {MODULE}, [CPT_TITLE], [CPT_DESC]
-->
<!--CUSTOM_HEADER_START//-->
[ATTR_CLASS]<div class="{ATTR_CLASS}"[ATTR_ID] id="{ATTR_ID}"[/ATTR_ID]>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]<div id="{ATTR_ID}">[/ATTR_ID][/ATTR_CLASS_ELSE]

[TITLE]<h3>{TITLE}</h3>[/TITLE]
[SUBTITLE]<h4>{SUBTITLE}</h4>[/SUBTITLE]
[TEXT]{TEXT}[/TEXT]

<div class="custom-cpt" id="custom{ID}">
<!--CUSTOM_HEADER_END//-->

<!--CUSTOM_ENTRY_START//-->
    <div class="customEntry[ITEM_FIRST] first[/ITEM_FIRST][ITEM_LAST] last[/ITEM_LAST]" id="custom-item-{ITEM_INDEX}">
        [CUSTCTP_TITLE]<h4>{CUSTCTP_TITLE}</h4>[/CUSTCTP_TITLE]
        [CUSTCTP_TEXT]{CUSTCTP_TEXT}[/CUSTCTP_TEXT]
    </div>

    <!--ENTRY_DATA_START//-->
    <!-- optional per-element data block, collected into {DATA} in header/footer -->
    <!--ENTRY_DATA_END//-->
<!--CUSTOM_ENTRY_END//-->

<!--CUSTOM_ENTRY_SPACER_START//--><!--CUSTOM_ENTRY_SPACER_END//-->

<!--CUSTOM_FOOTER_START//-->
</div>
[ATTR_CLASS]</div>[/ATTR_CLASS][ATTR_CLASS_ELSE][ATTR_ID]</div>[/ATTR_ID][/ATTR_CLASS_ELSE]
<!--CUSTOM_FOOTER_END//-->