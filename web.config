<rule name="Block private directories" stopProcessing="true">
	<match url="^(content/(tmp|cache|log|backup)|include/(config|vendor)|tests)/" />
	<action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
</rule>
<!-- filearchive/ is private by default; to enable the direct-download
     option of file list content parts, add it to the public paths rule. -->
<rule name="Block upload folders" stopProcessing="true">
	<match url="^upload/" />
	<action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
</rule>
<rule name="Block sensitive file types" stopProcessing="true">
	<match url="\.(sql|log|bak|dist)$" />
	<action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
</rule>
<rule name="Block development files" stopProcessing="true">
	<match url="^(CHANGELOG|README|DEPENDENCIES|SECURITY|CODE_OF_CONDUCT|ANTIGRAVITY|CLAUDE)\.md$|^(Makefile|stacklit\.json|composer\.lock)$" />
	<action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
</rule>
<rule name="Allow public paths" stopProcessing="true">
	<match url="^(template|img|picture|content/(form|images|rss|pages|marketing)|include/(inc_css|inc_js|inc_ext/ckeditor))(?:/|$)" />
	<action type="None" />
</rule>
<rule name="Allow PHP entry points" stopProcessing="true">
	<match url="^[^/]+\.php$" />
	<action type="None" />
</rule>
<rule name="Block non-public files" stopProcessing="true">
	<match url=".+" />
	<conditions>
		<add input="{REQUEST_FILENAME}" matchType="IsFile" />
	</conditions>
	<action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
</rule>
<rule name="Block non-public directories" stopProcessing="true">
	<match url=".+" />
	<conditions>
		<add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
	</conditions>
	<action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
</rule>
<rule name="rule 1S" stopProcessing="true">
	<match url="^(.+)"  />
	<action type="Rewrite" url="/-"  />
</rule>
<rule name="rule 2S" stopProcessing="true">
	<match url="^im\/(.+?)$"  />
	<action type="Rewrite" url="/./img/cmsimage.php?{R:1}"  />
</rule>
<rule name="rule 3S" stopProcessing="true">
	<match url="^dl\/([a-fA-Z0-9]+)\/(.*?)$"  />
	<action type="Rewrite" url="/./download.php?f={R:1}&amp;%{QUERY_STRING}"  />
</rule>
<rule name="rule 4S" stopProcessing="true">
	<match url="^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.html$"  />
	<action type="Rewrite" url="/./index.php?id={R:1},{R:2},{R:3},{R:4},{R:5},{R:6}&amp;%{QUERY_STRING}"  />
</rule>
<rule name="rule 5S" stopProcessing="true">
	<match url="^(.+)\.html$"  />
	<action type="Rewrite" url="/./index.php?{R:1}&amp;%{QUERY_STRING}"  />
</rule>
<rule name="rule 6S">
	<match url="^(.+)/?$"  />
	<action type="Rewrite" url="/./index.php?{R:1}&amp;%{QUERY_STRING}"  />
</rule>
