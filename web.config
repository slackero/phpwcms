<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Block sensitive files" stopProcessing="true">
                    <match url="(^|/)\.(?!well-known)|(composer\.(json|lock)|package(-lock)?\.json|Dockerfile|docker-compose\.ya?ml|Makefile|phpstan\.neon(\.default)?)$" />
                    <action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
                </rule>

                <rule name="Ignore known directories" stopProcessing="true">
                    <match url="^(template|content|picture|uploads?|include|filearchive|img)/" />
                    <action type="None" />
                </rule>

                <rule name="Ignore existing files and directories" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
                    </conditions>
                    <action type="None" />
                </rule>

                <rule name="Resized image" stopProcessing="true">
                    <match url="^im/(.+?)$" />
                    <action type="Rewrite" url="img/cmsimage.php?{R:1}" appendQueryString="false" />
                </rule>

                <rule name="File download" stopProcessing="true">
                    <match url="^dl/([a-fA-Z0-9]+)/(.*?)$" />
                    <action type="Rewrite" url="download.php?f={R:1}" appendQueryString="true" />
                </rule>

                <rule name="Numeric ID URL" stopProcessing="true">
                    <match url="^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.p?html$" />
                    <action type="Rewrite" url="index.php?id={R:1},{R:2},{R:3},{R:4},{R:5},{R:6}" appendQueryString="true" />
                </rule>

                <rule name="Generic Alias HTML" stopProcessing="true">
                    <match url="^(.+)\.p?html$" />
                    <action type="Rewrite" url="index.php?{R:1}" appendQueryString="true" />
                </rule>

                <rule name="Catch-all rewrite" stopProcessing="true">
                    <match url="^(.+)/?$" />
                    <action type="Rewrite" url="index.php?{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
