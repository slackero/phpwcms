<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />

        <security>
            <requestFiltering>
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".dist" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <rewrite>
            <rules>
                <!-- Hidden files, IDE settings, development files -->
                <rule name="Block hidden and development files" stopProcessing="true">
                    <match url="(^|/)\.(?!well-known)|/(composer\.(json|lock)|package(-lock)?\.json|Dockerfile|docker-compose\.ya?ml|Makefile|phpstan\.neon(\.default)?|stacklit\.json)$|/(CHANGELOG|README|DEPENDENCIES|SECURITY|CODE_OF_CONDUCT|ANTIGRAVITY|CLAUDE)\.md$" />
                    <action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
                </rule>

                <!-- Private storage, internal paths and upload folders -->
                <rule name="Block private paths" stopProcessing="true">
                    <match url="^(content/(tmp|cache|log|backup|form)|include/(config|vendor|inc_act|inc_front|inc_help|inc_lang|inc_lib|inc_module|inc_tmpl)|upload|tests)(?:/|$)" />
                    <action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
                </rule>

                <rule name="Block internal include extensions" stopProcessing="true">
                    <match url="^include/inc_ext/(?!ckeditor/)" />
                    <action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
                </rule>

                <rule name="Block setup configuration" stopProcessing="true">
                    <match url="^setup/setup\.conf\.inc\.php$" />
                    <action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
                </rule>

                <!-- PHP must never run from a private or upload directory -->
                <rule name="Block PHP in private directories" stopProcessing="true">
                    <match url="^(content|include|upload|filearchive|tests)/.*\.php$" />
                    <action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
                </rule>

                <!-- Only these paths are served statically. setup/ is needed for
                     a fresh installation and should be removed afterwards.
                     To enable the direct-download option of file list content
                     parts, add "filearchive" to this rule. -->
                <rule name="Allow public paths" stopProcessing="true">
                    <match url="^(template|img|picture|content/(images|rss|pages|marketing)|include/(inc_css|inc_js|inc_ext/ckeditor)|setup)(?:/|$)" />
                    <action type="None" />
                </rule>

                <!-- Root entry scripts stay reachable, including the form
                     upload controller formfile.php. -->
                <rule name="Allow root PHP entry points" stopProcessing="true">
                    <match url="^[^/]+\.php$" />
                    <action type="None" />
                </rule>

                <!-- Everything else that exists is not served -->
                <rule name="Block non-public files" stopProcessing="true">
                    <match url=".+" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                    </conditions>
                    <action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
                </rule>

                <rule name="Block non-public directories" stopProcessing="true">
                    <match url=".+" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
                    </conditions>
                    <action type="CustomResponse" statusCode="404" statusReason="File or directory not found" statusDescription="The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable." />
                </rule>

                <!-- Resized image /img/cmsimage.php/… -> /im/… -->
                <rule name="Resized image" stopProcessing="true">
                    <match url="^im/(.+?)$" />
                    <action type="Rewrite" url="img/cmsimage.php?{R:1}" appendQueryString="false" />
                </rule>

                <!-- File download /dl/… -> /download.php?… -->
                <rule name="File download" stopProcessing="true">
                    <match url="^dl/([a-fA-Z0-9]+)/(.*?)$" />
                    <action type="Rewrite" url="download.php?f={R:1}" appendQueryString="true" />
                </rule>

                <rule name="Numeric ID URL" stopProcessing="true">
                    <match url="^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)\.p?html$" />
                    <action type="Rewrite" url="index.php?id={R:1},{R:2},{R:3},{R:4},{R:5},{R:6}" appendQueryString="true" />
                </rule>

                <rule name="Generic Alias HTML" stopProcessing="true">
                    <match url="^(.+)\.p?html$" />
                    <action type="Rewrite" url="index.php?{R:1}" appendQueryString="true" />
                </rule>

                <rule name="Catch-all rewrite" stopProcessing="true">
                    <match url="^(.+)/?$" />
                    <action type="Rewrite" url="index.php?{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
